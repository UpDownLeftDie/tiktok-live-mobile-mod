# Relay (apps/relay) — loaded automatically from repo-root `.env` by `pnpm dev:relay`
EULER_API_KEY=your_euler_stream_api_key
# Local wrangler: http://127.0.0.1:8787
# Deployed: https://your-worker.example.workers.dev
WORKER_URL=http://127.0.0.1:8787
# Must match RELAY_SECRET in apps/worker/.dev.vars (local) or Worker secrets (prod)
RELAY_SECRET=generate_a_long_random_string
POLL_INTERVAL_MS=5000
# How often to retry connecting when a checked-in streamer is offline
OFFLINE_RETRY_MS=30000
# How often to refresh the TikTok gift catalog from GitHub dumps (default 6h)
# GIFT_CATALOG_SYNC_MS=21600000

# Spike only (optional)
SPIKE_USERNAME=some_public_live_username
