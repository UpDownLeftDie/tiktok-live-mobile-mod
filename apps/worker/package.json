{
  "name": "@tiktok-mod/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build:client && wrangler dev",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "pnpm build:client",
    "build:client": "vite build --config client/vite.config.ts",
    "deploy": "pnpm build:client && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit && tsc -p client/tsconfig.sw.json --noEmit",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@pushforge/builder": "^2.0.5",
    "@tiktok-mod/shared": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "workbox-precaching": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260830.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.127.1"
  }
}
